# --- Your personal documents: NEVER commit these ---------------------------
# This tool is meant to be used with your own resume and project write-ups.
# Everything you drop in documents/ stays on your machine.
documents/*
!documents/README.md

# --- Generated data --------------------------------------------------------
# The local vector store. Rebuildable from documents/ at any time.
# NOTE: a trailing '#' comment on this line would NOT be treated as a
# comment — .gitignore only honours '#' at the start of a line, and the
# pattern would silently match nothing.
chroma_db/

# --- Secrets ---------------------------------------------------------------
.env

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# --- macOS -----------------------------------------------------------------
.DS_Store
